{
  "name": "dsh-media-downloader",
  "version": "1.6.0",
  "type": "module",
  "description": "Multi-site media downloader for DSH: Bilibili, Douyin and Xiaohongshu via native parsers, other sites via yt-dlp",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/bili.mjs",
    "lib/ytdlp.mjs",
    "lib/qr.mjs",
    "lib/douyin.mjs",
    "lib/xhs.mjs",
    "lib/browser-login.mjs",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "docs/*.md",
    "docs/*.png",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lohana20061023-29/dsh-media-downloader.git"
  },
  "homepage": "https://github.com/lohana20061023-29/dsh-media-downloader#readme",
  "bugs": {
    "url": "https://github.com/lohana20061023-29/dsh-media-downloader/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "bilibili",
    "douyin",
    "xiaohongshu",
    "yt-dlp",
    "download"
  ],
  "license": "MIT",
  "author": "Lohana",
  "engines": {
    "node": ">=18"
  }
}
